                badge: "Penyerap Air Utama",
                color: "amber",
                desc: "Buluan halus di sekitar cabang akar. Memiliki fungsi khusus menyerap air dan mineral hara dari pori-pori tanah secara maksimal."
            },
            tudung: {
                title: "5. Tudung Akar (Kaliptra)",
                badge: "Pelindung Ujung",
                color: "purple",
                desc: "Terletak di paling ujung akar. Fungsinya melindungi ujung akar yang lembut saat menembus butiran tanah yang keras."
            }
        };

        function selectRootPart(partKey) {
            playSound('click');
            const data = rootPartsInfo[partKey];
            const infoBox = document.getElementById('anatomy-info-box');

            infoBox.innerHTML = `
                <div class="space-y-3 animate-fade-in">
                    <span class="inline-block px-3 py-1 bg-${data.color}-100 text-${data.color}-800 font-bold rounded-full text-xs">${data.badge}</span>
                    <h4 class="font-fun text-xl font-bold text-slate-800">${data.title}</h4>
                    <p class="text-xs md:text-sm text-slate-700 leading-relaxed">${data.desc}</p>
                </div>
            `;
        }

        /* ==================== MATCHING GAME LOGIC ==================== */
        const matchingPairs = [
            { id: 1, part: "Rambut Akar", desc: "Menyerap air dan mineral dari tanah" },
            { id: 2, part: "Tudung Akar (Kaliptra)", desc: "Melindungi ujung akar saat menembus tanah" },
            { id: 3, part: "Akar Tunggang", desc: "Memiliki 1 akar utama yang besar & dalam" },
            { id: 4, part: "Akar Serabut", desc: "Akar berupa kumpulan benang halus sejajar" }
        ];

        let selectedLeft = null;
        let selectedRight = null;
        let matchedCount = 0;

        function initMatchingGame() {
            selectedLeft = null;
            selectedRight = null;
            matchedCount = 0;

            const toast = document.getElementById('matching-toast');
            toast.className = 'hidden mb-4 p-3 rounded-xl text-center font-bold text-sm';

            // Shuffle right answers
            const shuffledRight = [...matchingPairs].sort(() => Math.random() - 0.5);

            let leftHtml = '';
            matchingPairs.forEach(pair => {
                leftHtml += `
                    <button id="match-left-${pair.id}" onclick="selectMatchLeft(${pair.id})" class="match-btn-left w-full p-3 rounded-xl border-2 border-sky-200 bg-sky-50 text-sky-900 font-bold text-xs md:text-sm text-left hover:bg-sky-100 transition shadow-sm flex items-center justify-between">
                        <span>${pair.part}</span>
                        <i class="fas fa-circle text-sky-300 text-xs"></i>
                    </button>
                `;
            });
            document.getElementById('matching-left-list').innerHTML = leftHtml;

            let rightHtml = '';
            shuffledRight.forEach(pair => {
                rightHtml += `
                    <button id="match-right-${pair.id}" onclick="selectMatchRight(${pair.id})" class="match-btn-right w-full p-3 rounded-xl border-2 border-amber-200 bg-amber-50 text-amber-900 font-semibold text-xs md:text-sm text-left hover:bg-amber-100 transition shadow-sm flex items-center justify-between">
                        <span>${pair.desc}</span>
                        <i class="fas fa-circle text-amber-300 text-xs"></i>
                    </button>
                `;
            });
            document.getElementById('matching-right-list').innerHTML = rightHtml;
        }

        function selectMatchLeft(id) {
            playSound('click');
            selectedLeft = id;
            document.querySelectorAll('.match-btn-left').forEach(btn => {
                btn.classList.remove('ring-4', 'ring-sky-400', 'bg-sky-200');
            });
            const activeBtn = document.getElementById(`match-left-${id}`);
            if (activeBtn) activeBtn.classList.add('ring-4', 'ring-sky-400', 'bg-sky-200');
            checkMatch();
        }

        function selectMatchRight(id) {
            playSound('click');
            selectedRight = id;
            document.querySelectorAll('.match-btn-right').forEach(btn => {
                btn.classList.remove('ring-4', 'ring-amber-400', 'bg-amber-200');
            });
            const activeBtn = document.getElementById(`match-right-${id}`);
            if (activeBtn) activeBtn.classList.add('ring-4', 'ring-amber-400', 'bg-amber-200');
            checkMatch();
        }

        function checkMatch() {
            if (selectedLeft !== null && selectedRight !== null) {
                const toast = document.getElementById('matching-toast');
                toast.classList.remove('hidden');

                if (selectedLeft === selectedRight) {
                    playSound('correct');
                    toast.className = 'mb-4 p-3 rounded-xl text-center font-bold text-xs md:text-sm bg-emerald-100 text-emerald-800 border border-emerald-300';
                    toast.innerText = '🎉 Benar! Pasanganmu Sangat Tepat!';

                    // Disable matched items
                    const leftBtn = document.getElementById(`match-left-${selectedLeft}`);
                    const rightBtn = document.getElementById(`match-right-${selectedRight}`);
                    
                    if (leftBtn) {
                        leftBtn.disabled = true;
                        leftBtn.className = 'w-full p-3 rounded-xl bg-emerald-100 border-2 border-emerald-400 text-emerald-800 font-bold text-xs md:text-sm text-left opacity-75';
                        leftBtn.innerHTML += ' <i class="fas fa-check-circle text-emerald-600"></i>';
                    }
                    if (rightBtn) {
                        rightBtn.disabled = true;
                        rightBtn.className = 'w-full p-3 rounded-xl bg-emerald-100 border-2 border-emerald-400 text-emerald-800 font-semibold text-xs md:text-sm text-left opacity-75';
                        rightBtn.innerHTML += ' <i class="fas fa-check-circle text-emerald-600"></i>';
                    }

                    matchedCount++;
                    if (matchedCount === matchingPairs.length) {
                        playSound('fanfare');
                        toast.innerText = '🏆 HEBAT! Kamu Menyelesaikan Semua Pasangan dengan Benar!';
                    }
                } else {
                    playSound('wrong');
                    toast.className = 'mb-4 p-3 rounded-xl text-center font-bold text-xs md:text-sm bg-rose-100 text-rose-800 border border-rose-300';
                    toast.innerText = '❌ Coba Lagi! Pasangan tersebut kurang tepat.';
                }

                // Reset selections
                selectedLeft = null;
                selectedRight = null;
            }
        }

        function resetMatchingGame() {
            playSound('click');
            initMatchingGame();
        }

        /* ==================== QUIZ QUESTIONS (10 ITEMS) ==================== */
        const quizQuestions = [
            {
                q: "1. Dimanakah letak keberadaan akar tumbuhan pada umumnya?",
                options: ["Di atas daun", "Di dalam tanah", "Mengapung di awan", "Di dalam buah"],
                answer: 1,
                explain: "Akar pada umumnya tumbuh menghujam ke dalam tanah untuk menyerap air dan menopang tanaman."
            },
            {
                q: "2. Bagian akar yang bertugas khusus menyerap air dan mineral hara dari tanah adalah...",
                options: ["Tudung akar", "Rambut akar", "Batang utama", "Bunga"],
                answer: 1,
                explain: "Rambut atau bulu akar memiliki permukaan halus yang efektif menyerap air dari dalam tanah."
            },
            {
                q: "3. Apa fungsi utama dari tudung akar (kaliptra)?",
                options: ["Menyimpan cadangan makanan", "Melindungi ujung akar saat menembus tanah", "Menyerap cahaya matahari", "Menarik perhatian serangga"],
                answer: 1,
                explain: "Tudung akar berada di bagian paling depan untuk melindungi jaringan lembut ujung akar dari gesekan tanah."
            },
            {
                q: "4. Tumbuhan manakah di bawah ini yang memiliki jenis akar tunggang?",
                options: ["Padi", "Jagung", "Pohon Mangga", "Rumput"],
                answer: 2,
                explain: "Pohon Mangga adalah tumbuhan dikotil berkambium yang memiliki akar tunggang yang kuat."
            },
            {
                q: "5. Ciri utama dari akar serabut adalah...",
                options: ["Memiliki 1 akar utama yang sangat besar", "Akar berbentuk kumpulan benang sejajar dari pangkal batang", "Hanya tumbuh di atas pohon", "Berwarna merah terang"],
                answer: 1,
                explain: "Akar serabut tidak memiliki akar utama, melainkan banyak akar halus berukuran sama dari pangkal batang."
            },
            {
                q: "6. Wortel dan Singkong memanfaatkan akarnya sebagai tempat...",
                options: ["Alat fotosintesis", "Penyimpanan cadangan makanan", "Alat perkembangbiakan stek", "Menarik air hujan"],
                answer: 1,
                explain: "Wortel dan singkong menyimpan hasil fotosintesis di dalam akar (umbi akar)."
            },
            {
                q: "7. Mengapa akar tanaman sangat penting saat hujan deras terjadi di lereng gunung?",
                options: ["Membuat tanah menjadi licin", "Mencegah erosi dan tanah longsor", "Menghentikan hujan turun", "Mengubah warna tanah"],
                answer: 1,
                explain: "Cengkeraman akar pohon di dalam tanah mengikat butiran tanah sehingga mencegah erosi dan bencana tanah longsor."
            },
            {
                q: "8. Tumbuhan padi dan jagung tergolong memiliki jenis akar...",
                options: ["Tunggang", "Serabut", "Napas", "Pelekat"],
                answer: 1,
                explain: "Padi dan jagung merupakan tumbuhan monokotil yang memiliki sistem perakaran serabut."
            },
            {
                q: "9. Bagian yang menghubungkan akar dengan batang tumbuhan disebut...",
                options: ["Ujung akar", "Leher / Pangkal akar", "Tudung akar", "Daun majemuk"],
                answer: 1,
                explain: "Leher akar adalah zona perbatasan tempat ditemukannya batas antara akar dan pangkal batang."
            },
            {
                q: "10. Manakah yang BUKAN merupakan fungsi dari akar tumbuhan?",
                options: ["Menyerap air dan zat hara", "Menancapkan tumbuhan agar kokoh", "Melakukan proses fotosintesis menghasilkan buah", "Menyimpan cadangan makanan"],
                answer: 2,
                explain: "Fotosintesis utama terjadi di daun yang mengandung klorofil, bukan tugas utama akar."
            }
        ];

        function loadQuizQuestion() {
            const q = quizQuestions[currentQuizIndex];
            document.getElementById('quiz-num-badge').innerText = currentQuizIndex + 1;
            document.getElementById('quiz-current-num').innerText = currentQuizIndex + 1;
            document.getElementById('quiz-live-score').innerText = quizScore;
            document.getElementById('quiz-question-text').innerText = q.q;

            // Reset feedback
            const feedbackBox = document.getElementById('quiz-feedback-box');
            feedbackBox.classList.add('hidden');

            const btnNext = document.getElementById('btn-quiz-next');
            btnNext.classList.add('hidden');

            let optionsHtml = '';
            const labels = ['A', 'B', 'C', 'D'];
            q.options.forEach((opt, idx) => {
                optionsHtml += `
                    <button onclick="checkQuizAnswer(${idx})" id="opt-btn-${idx}" class="quiz-opt-btn w-full p-3.5 rounded-2xl border-2 border-slate-200 bg-slate-50 text-slate-800 font-semibold text-xs md:text-sm text-left hover:bg-emerald-50 hover:border-emerald-300 transition flex items-center space-x-3">
                        <span class="w-7 h-7 rounded-xl bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center flex-shrink-0">${labels[idx]}</span>
                        <span>${opt}</span>
                    </button>
                `;
            });
            document.getElementById('quiz-options-container').innerHTML = optionsHtml;
        }

        function checkQuizAnswer(selectedIdx) {
            playSound('click');
            const q = quizQuestions[currentQuizIndex];
            
            // Disable all option buttons
            const buttons = document.querySelectorAll('.quiz-opt-btn');
            buttons.forEach(btn => btn.disabled = true);

            const feedbackBox = document.getElementById('quiz-feedback-box');
            const feedbackTitle = document.getElementById('quiz-feedback-title');
            const feedbackDesc = document.getElementById('quiz-feedback-desc');

            feedbackBox.classList.remove('hidden');

            if (selectedIdx === q.answer) {
                playSound('correct');
                quizScore += 10;
                correctAnswers++;
                userAnswers.push({ q: currentQuizIndex + 1, isCorrect: true });

                document.getElementById(`opt-btn-${selectedIdx}`).className = "w-full p-3.5 rounded-2xl border-2 border-emerald-500 bg-emerald-100 text-emerald-900 font-bold text-xs md:text-sm text-left flex items-center space-x-3";
                
                feedbackBox.className = "p-4 rounded-2xl border-2 bg-emerald-50 border-emerald-300 text-emerald-900";
                feedbackTitle.innerText = "✨ Jawabanmu Benar! Hebat!";
            } else {
                playSound('wrong');
                wrongAnswers++;
                userAnswers.push({ q: currentQuizIndex + 1, isCorrect: false });

                document.getElementById(`opt-btn-${selectedIdx}`).className = "w-full p-3.5 rounded-2xl border-2 border-rose-500 bg-rose-100 text-rose-900 font-bold text-xs md:text-sm text-left flex items-center space-x-3";
                document.getElementById(`opt-btn-${q.answer}`).className = "w-full p-3.5 rounded-2xl border-2 border-emerald-500 bg-emerald-100 text-emerald-900 font-bold text-xs md:text-sm text-left flex items-center space-x-3";

                feedbackBox.className = "p-4 rounded-2xl border-2 bg-rose-50 border-rose-300 text-rose-900";
                feedbackTitle.innerText = "❌ Jawaban Kurang Tepat!";
            }

            feedbackDesc.innerText = q.explain;
            document.getElementById('quiz-live-score').innerText = quizScore;

            const btnNext = document.getElementById('btn-quiz-next');
            btnNext.classList.remove('hidden');

            if (currentQuizIndex === quizQuestions.length - 1) {
                btnNext.innerText = "Lihat Hasil Akhir Kuis 🏆";
            } else {
                btnNext.innerText = "Lanjut Soal Berikutnya ➡️";
            }
        }

        function nextQuestion() {
            playSound('click');
            if (currentQuizIndex < quizQuestions.length - 1) {
                currentQuizIndex++;
                loadQuizQuestion();
            } else {
                finishQuiz();
            }
        }

        function finishQuiz() {
            document.getElementById('res-student-name').innerText = studentData.nama;
            document.getElementById('res-score-number').innerText = quizScore;
            document.getElementById('res-correct-count').innerText = correctAnswers;
            document.getElementById('res-wrong-count').innerText = wrongAnswers;

            let category = "";
            let motivation = "";
            let badgeIcon = "🏆";

            if (quizScore >= 90) {
                category = "Sangat Baik 🌟";
                motivation = "Luar Biasa! Kamu sangat memahami bagian dan fungsi akar tumbuhan dengan sempurna!";
                badgeIcon = "🌟";
                playSound('fanfare');
            } else if (quizScore >= 80) {
                category = "Baik 👍";
                motivation = "Hebat Sekali! Kamu berhasil menguasai sebagian besar materi akar!";
                badgeIcon = "👏";
                playSound('fanfare');
            } else if (quizScore >= 70) {
                category = "Cukup 🙂";
                motivation = "Bagus! Terus tingkatkan belajar untuk pemahaman yang lebih maksimal.";
                badgeIcon = "🌱";
            } else {
                category = "Perlu Bimbingan 📚";
                motivation = "Jangan berkecil hati! Pelajari kembali materi slide dan coba kuis sekali lagi ya!";
                badgeIcon = "💪";
            }

            document.getElementById('res-category-pill').innerText = category;
            document.getElementById('res-motivation-text').innerText = `"${motivation}"`;
            document.getElementById('result-badge-icon').innerText = badgeIcon;

            showScreen('result-screen');
        }

        function restartQuiz() {
            playSound('click');
            currentQuizIndex = 0;
            quizScore = 0;
            correctAnswers = 0;
            wrongAnswers = 0;
            userAnswers = [];
            showScreen('quiz-screen');
        }

        /* ==================== FORM SUBMISSION TO GOOGLE SHEETS ==================== */
        document.getElementById('reflection-form').addEventListener('submit', function (e) {
            e.preventDefault();
            playSound('click');

            const btnSubmit = document.getElementById('btn-submit-all');
            const statusBanner = document.getElementById('submit-status-banner');

            const q1 = document.getElementById('ref-q1').value.trim();
            const q2 = document.getElementById('ref-q2').value.trim();
            const q3 = document.getElementById('ref-q3').value.trim();
            const q4 = document.getElementById('ref-q4').value.trim();

            if (!q1 || !q2 || !q3 || !q4) {
                alert("Mohon isi semua pertanyaan refleksi ya!");
                return;
            }

            btnSubmit.disabled = true;
            btnSubmit.innerHTML = `<i class="fas fa-spinner fa-spin"></i> <span>Mengirim Data...</span>`;

            statusBanner.classList.remove('hidden');
            statusBanner.className = "p-4 rounded-2xl text-center text-xs md:text-sm font-bold bg-amber-100 text-amber-900 border border-amber-300";
            statusBanner.innerText = "⏳ Sedang menghubungkan ke Google Sheets...";

            const now = new Date();
            const tanggalStr = now.toLocaleDateString('id-ID');
            const waktuStr = now.toLocaleTimeString('id-ID');

            let kategori = "Belum Kuis";
            if (quizScore >= 90) kategori = "Sangat Baik";
            else if (quizScore >= 80) kategori = "Baik";
            else if (quizScore >= 70) kategori = "Cukup";
            else kategori = "Perlu Bimbingan";

            const payloadData = {
                tanggal: tanggalStr,
                waktu: waktuStr,
                nama: studentData.nama || "Anonym",
                kelas: studentData.kelas || "4 SD",
                absen: studentData.absen || "-",
                nilai: quizScore,
                benar: correctAnswers,
                salah: wrongAnswers,
                kategori: kategori,
                refleksi1: q1,
                refleksi2: q2,
                refleksi3: q3,
                refleksi4: q4
            };

            // Send via POST to Google Apps Script Web App
            if (GOOGLE_SHEETS_WEB_APP_URL.includes("EXAMPLE_WEB_APP_URL")) {
                setTimeout(() => {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = `<i class="fas fa-paper-plane"></i> <span>Kirim Hasil Belajar ke Guru</span>`;
                    statusBanner.className = "p-4 rounded-2xl text-center text-xs md:text-sm font-bold bg-sky-100 text-sky-900 border border-sky-300";
                    statusBanner.innerHTML = `
                        ⚠️ <strong>Simulasi Berhasil!</strong><br>
                        (Catatan Guru: Tautan URL Google Apps Script belum diganti di variabel <code>GOOGLE_SHEETS_WEB_APP_URL</code>. Data simulasi siap dikirim).
                    `;
                }, 1200);
                return;
            }

            fetch(GOOGLE_SHEETS_WEB_APP_URL, {
                method: 'POST',
                mode: 'no-cors',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payloadData)
            })
            .then(res => {
                playSound('fanfare');
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = `<i class="fas fa-check-circle"></i> <span>Terkirim!</span>`;
                statusBanner.className = "p-4 rounded-2xl text-center text-xs md:text-sm font-bold bg-emerald-100 text-emerald-900 border border-emerald-300";
                statusBanner.innerHTML = `🎉 <strong>Hore! Data Hasil Belajar Berhasil Terkirim ke Google Sheets Guru!</strong>`;
            })
            .catch(err => {
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = `<i class="fas fa-paper-plane"></i> <span>Coba Kirim Lagi</span>`;
                statusBanner.className = "p-4 rounded-2xl text-center text-xs md:text-sm font-bold bg-rose-100 text-rose-900 border border-rose-300";
                statusBanner.innerText = "❌ Terjadi kendala koneksi internet. Silakan coba lagi.";
            });
        });

        window.onload = function() {
            renderSlide();
        };
    </script>
</body>
</html>
