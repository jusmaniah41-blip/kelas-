<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan Mengenal Akar - IPAS Kelas 4 SD</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti for Celebration Effects -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts: Fredoka & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            green: '#10B981',
                            lightgreen: '#D1FAE5',
                            darkgreen: '#047857',
                            yellow: '#F59E0B',
                            lightyellow: '#FEF3C7',
                            blue: '#0284C7',
                            lightblue: '#E0F2FE',
                            brown: '#8B4513',
                            lightbrown: '#F5E6D3'
                        }
                    },
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        body: ['Plus Jakarta Sans', 'sans-serif']
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F0FDF4;
            user-select: none;
        }
        h1, h2, h3, h4, .font-fun {
            font-family: 'Fredoka', cursive;
        }
        .btn-bounce:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        .btn-bounce:active {
            transform: translateY(1px) scale(0.98);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #E0F2FE;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #0284C7;
            border-radius: 10px;
        }
        /* Pulse effect for interactive hotspots */
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.15); opacity: 0.4; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .hotspot-ring {
            animation: pulse-ring 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-emerald-50 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- HEADER NAVBAR -->
    <header class="bg-white/90 backdrop-blur border-b-4 border-emerald-400 sticky top-0 z-50 shadow-md">
        <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3 cursor-pointer" onclick="showScreen('home-screen')">
                <div class="bg-amber-400 text-amber-900 w-10 h-10 rounded-2xl flex items-center justify-center font-bold text-2xl shadow">
                    🌱
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold text-emerald-800 font-fun leading-none">Petualangan Akar</h1>
                    <p class="text-xs text-emerald-600 font-semibold hidden sm:block">IPAS Kelas 4 SD - Kurikulum Merdeka</p>
                </div>
            </div>

            <!-- Header Action Controls -->
            <div class="flex items-center space-x-2">
                <button id="btn-sound" onclick="toggleSound()" class="p-2.5 rounded-xl bg-emerald-100 hover:bg-emerald-200 text-emerald-700 transition" title="Efek Suara">
                    <i class="fas fa-volume-up text-lg" id="sound-icon"></i>
                </button>
                <button onclick="openGoogleDocs()" class="px-3 py-2 bg-sky-500 hover:bg-sky-600 text-white rounded-xl text-xs md:text-sm font-semibold flex items-center space-x-1.5 shadow transition">
                    <i class="fas fa-file-alt"></i>
                    <span class="hidden md:inline">Materi Complete</span> (Docs)
                </button>
                <button onclick="showScreen('menu-screen')" id="btn-menu-header" class="hidden px-3 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl text-xs md:text-sm font-semibold flex items-center space-x-1 shadow transition">
                    <i class="fas fa-th-large"></i>
                    <span>Menu</span>
                </button>
            </div>
        </div>

        <!-- Global Learning Progress Bar -->
        <div class="w-full bg-emerald-100 h-2">
            <div id="learning-progress-bar" class="bg-amber-400 h-2 transition-all duration-500" style="width: 10%;"></div>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-4xl mx-auto px-4 py-6 flex-grow w-full">

        <!-- ==================== 1. BERANDA & DATA SISWA ==================== -->
        <section id="home-screen" class="space-y-6">
            <div class="bg-white rounded-3xl p-6 md:p-8 shadow-xl border-4 border-emerald-300 text-center relative overflow-hidden">
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-amber-200 rounded-full opacity-50 blur-lg"></div>
                <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-sky-200 rounded-full opacity-50 blur-lg"></div>

                <div class="inline-block px-4 py-1.5 bg-emerald-100 text-emerald-800 rounded-full text-xs md:text-sm font-bold mb-4 border border-emerald-300">
                    ✨ Media Pembelajaran Interaktif Kelas 4 SD
                </div>

                <h2 class="text-3xl md:text-5xl font-extrabold text-emerald-800 font-fun mb-2">
                    Petualangan Mengenal Akar! 🌿
                </h2>
                <p class="text-slate-600 text-sm md:text-base max-w-xl mx-auto mb-6">
                    Mari jelajahi rahasia hebat di bawah tanah! Cari tahu bagian-bagian akar, fungsinya, dan seberapa penting akar bagi kehidupan tanaman.
                </p>

                <!-- Student Identity Form Card -->
                <div class="bg-amber-50 rounded-2xl p-5 md:p-6 border-2 border-amber-200 text-left max-w-md mx-auto shadow-inner mb-6">
                    <h3 class="text-lg font-bold text-amber-900 font-fun mb-3 flex items-center gap-2">
                        <i class="fas fa-user-graduate text-amber-600"></i> Isikan Datamu Dahulu Ya!
                    </h3>
                    <form id="student-form" class="space-y-3">
                        <div>
                            <label class="block text-xs font-bold text-amber-900 mb-1">Nama Lengkap Siswa:</label>
                            <input type="text" id="input-nama" required placeholder="Contoh: Budi Pratama" class="w-full px-3.5 py-2.5 rounded-xl border-2 border-amber-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none text-sm font-semibold">
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-bold text-amber-900 mb-1">Kelas:</label>
                                <input type="text" id="input-kelas" value="4 SD" required placeholder="4 SD" class="w-full px-3.5 py-2.5 rounded-xl border-2 border-amber-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none text-sm font-semibold">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-amber-900 mb-1">No. Absen:</label>
                                <input type="number" id="input-absen" required placeholder="12" class="w-full px-3.5 py-2.5 rounded-xl border-2 border-amber-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 outline-none text-sm font-semibold">
                            </div>
                        </div>
                    </form>
                </div>

                <button onclick="startLearning()" class="btn-bounce bg-emerald-500 hover:bg-emerald-600 text-white font-fun text-xl px-8 py-4 rounded-2xl shadow-lg border-b-4 border-emerald-700 flex items-center justify-center gap-3 mx-auto transition">
                    <span>Mulai Belajar Sekarang</span>
                    <i class="fas fa-arrow-right"></i>
                </button>

                <!-- Usage Guide Box -->
                <div class="mt-8 pt-6 border-t border-slate-200 text-xs text-slate-500 text-left grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div class="flex items-start gap-2">
                        <i class="fas fa-book-reader text-emerald-600 text-base mt-0.5"></i>
                        <span><strong>1. Baca Materi:</strong> Pelajari definisi dan jenis akar.</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <i class="fas fa-gamepad text-amber-600 text-base mt-0.5"></i>
                        <span><strong>2. Bermain Interaktif:</strong> Jelajahi anatomi & game pasangkan.</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <i class="fas fa-trophy text-sky-600 text-base mt-0.5"></i>
                        <span><strong>3. Kuis & Simpan:</strong> Dapatkan nilai & kirim hasil ke Guru.</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== 2. MENU UTAMA ==================== -->
        <section id="menu-screen" class="hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 shadow-xl border-4 border-emerald-300">
                <div class="flex items-center justify-between mb-6 pb-3 border-b">
                    <div>
                        <h2 class="text-2xl font-bold text-emerald-800 font-fun">Pilih Petualanganmu! 🚀</h2>
                        <p class="text-xs md:text-sm text-slate-600">Halo <span id="display-student-name" class="font-bold text-emerald-600">Siswa</span>, pilih menu di bawah ini!</p>
                    </div>
                    <span class="px-3 py-1 bg-amber-100 text-amber-800 rounded-full text-xs font-bold" id="display-student-info">Kelas 4</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Menu Item 1 -->
                    <button onclick="showScreen('materi-screen')" class="btn-bounce bg-emerald-50 hover:bg-emerald-100 p-5 rounded-2xl border-2 border-emerald-300 text-left flex items-center space-x-4 transition">
                        <div class="bg-emerald-500 text-white w-14 h-14 rounded-2xl flex items-center justify-center text-2xl shadow">
                            📖
                        </div>
                        <div>
                            <h3 class="font-fun text-lg text-emerald-900 font-bold">1. Materi Belajar Akar</h3>
                            <p class="text-xs text-slate-600">Pelajari arti, fungsi, dan jenis-jenis akar.</p>
                        </div>
                    </button>

                    <!-- Menu Item 2 -->
                    <button onclick="showScreen('anatomy-screen')" class="btn-bounce bg-amber-50 hover:bg-amber-100 p-5 rounded-2xl border-2 border-amber-300 text-left flex items-center space-x-4 transition">
                        <div class="bg-amber-500 text-white w-14 h-14 rounded-2xl flex items-center justify-center text-2xl shadow">
                            🔍
                        </div>
                        <div>
                            <h3 class="font-fun text-lg text-amber-900 font-bold">2. Kenali Bagian Akar</h3>
                            <p class="text-xs text-slate-600">Klik diagram akar interaktif untuk investigasi!</p>
                        </div>
                    </button>

                    <!-- Menu Item 3 -->
                    <button onclick="showScreen('matching-screen')" class="btn-bounce bg-sky-50 hover:bg-sky-100 p-5 rounded-2xl border-2 border-sky-300 text-left flex items-center space-x-4 transition">
                        <div class="bg-sky-500 text-white w-14 h-14 rounded-2xl flex items-center justify-center text-2xl shadow">
                            🧩
                        </div>
                        <div>
                            <h3 class="font-fun text-lg text-sky-900 font-bold">3. Permainan Pasangkan</h3>
                            <p class="text-xs text-slate-600">Jodohkan bagian akar dengan fungsinya.</p>
                        </div>
                    </button>

                    <!-- Menu Item 4 -->
                    <button onclick="showScreen('quiz-screen')" class="btn-bounce bg-rose-50 hover:bg-rose-100 p-5 rounded-2xl border-2 border-rose-300 text-left flex items-center space-x-4 transition">
                        <div class="bg-rose-500 text-white w-14 h-14 rounded-2xl flex items-center justify-center text-2xl shadow">
                            🎯
                        </div>
                        <div>
                            <h3 class="font-fun text-lg text-rose-900 font-bold">4. Kuis Interaktif</h3>
                            <p class="text-xs text-slate-600">Uji pemahamanmu lewat 10 soal seru.</p>
                        </div>
                    </button>
                </div>

                <div class="mt-6 pt-4 border-t flex flex-wrap justify-between items-center gap-3">
                    <button onclick="showScreen('reflection-screen')" class="px-4 py-2.5 bg-purple-100 hover:bg-purple-200 text-purple-800 font-bold rounded-xl text-xs md:text-sm flex items-center gap-2 transition">
                        <i class="fas fa-pen-alt"></i> Isi Refleksi Belajar
                    </button>
                    <button onclick="openGoogleDocs()" class="px-4 py-2.5 bg-sky-100 hover:bg-sky-200 text-sky-800 font-bold rounded-xl text-xs md:text-sm flex items-center gap-2 transition">
                        <i class="fas fa-external-link-alt"></i> Buka Rangkuman Google Docs
                    </button>
                </div>
            </div>
        </section>

        <!-- ==================== 3. MENU MATERI ==================== -->
        <section id="materi-screen" class="hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 shadow-xl border-4 border-emerald-300">
                <!-- Slide Header -->
                <div class="flex items-center justify-between mb-4 pb-2 border-b">
                    <span class="text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full" id="materi-slide-num">Slide 1 dari 5</span>
                    <button onclick="showScreen('menu-screen')" class="text-xs font-bold text-slate-500 hover:text-slate-800">
                        <i class="fas fa-times"></i> Tutup
                    </button>
                </div>

                <!-- Slide Containers -->
                <div id="materi-content-box" class="min-h-[320px] flex flex-col justify-between">
                    <!-- Dynamic Slide Content Inserted via JS -->
                </div>

                <!-- Navigation Controls -->
                <div class="flex items-center justify-between mt-6 pt-4 border-t">
                    <button id="btn-materi-prev" onclick="prevSlide()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 rounded-xl font-bold text-sm flex items-center gap-2 transition">
                        <i class="fas fa-chevron-left"></i> Sebelumnya
                    </button>
                    <button onclick="showScreen('menu-screen')" class="px-3 py-2 bg-amber-100 hover:bg-amber-200 text-amber-800 rounded-xl font-bold text-xs">
                        <i class="fas fa-th"></i> Menu
                    </button>
                    <button id="btn-materi-next" onclick="nextSlide()" class="px-5 py-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl font-bold text-sm flex items-center gap-2 shadow transition">
                        <span>Berikutnya</span> <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- ==================== 4. AKTIVITAS 1: KENALI BAGIAN AKAR ==================== -->
        <section id="anatomy-screen" class="hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 shadow-xl border-4 border-amber-300">
                <div class="text-center mb-6">
                    <span class="bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-bold">Aktivitas Interaktif</span>
                    <h2 class="text-2xl md:text-3xl font-bold text-amber-900 font-fun mt-1">Eksplorasi Anatomi Akar 🌱</h2>
                    <p class="text-xs md:text-sm text-slate-600">Klik titik-titik melayang pada diagram di bawah untuk membuka informasi rahasia!</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                    <!-- Interactive SVG Diagram -->
                    <div class="md:col-span-6 bg-emerald-50 p-4 rounded-2xl border-2 border-emerald-200 flex justify-center relative min-h-[300px]">
                        <svg viewBox="0 0 300 360" class="w-full max-w-[280px] h-auto drop-shadow-md">
                            <!-- Tanah (Soil Line) -->
                            <rect x="0" y="0" width="300" height="60" fill="#A78BFA" opacity="0.1"/>
                            <line x1="0" y1="60" x2="300" y2="60" stroke="#8B4513" stroke-width="4" stroke-dasharray="6,4"/>
                            <text x="10" y="30" font-family="Fredoka" font-size="12" fill="#8B4513">🌱 Batang Utama & Tanah</text>

                            <!-- Akar Utama (Tunggang) -->
                            <path d="M 150 60 C 145 120, 155 200, 150 290" stroke="#8B4513" stroke-width="16" fill="none" stroke-linecap="round"/>
                            <path d="M 150 60 C 145 120, 155 200, 150 290" stroke="#D97706" stroke-width="10" fill="none" stroke-linecap="round"/>

                            <!-- Cabang Akar -->
                            <path d="M 150 110 C 120 130, 90 140, 60 145" stroke="#D97706" stroke-width="5" fill="none" stroke-linecap="round"/>
                            <path d="M 150 140 C 180 160, 210 170, 240 180" stroke="#D97706" stroke-width="5" fill="none" stroke-linecap="round"/>
                            <path d="M 150 190 C 120 210, 100 220, 75 235" stroke="#D97706" stroke-width="4" fill="none" stroke-linecap="round"/>

                            <!-- Rambut Akar Fine Details -->
                            <path d="M 60 145 C 45 150, 35 155, 25 155" stroke="#F59E0B" stroke-width="2" fill="none"/>
                            <path d="M 240 180 C 255 185, 265 190, 275 195" stroke="#F59E0B" stroke-width="2" fill="none"/>
                            <path d="M 75 235 C 60 240, 50 245, 40 250" stroke="#F59E0B" stroke-width="2" fill="none"/>

                            <!-- Tudung Akar / Tip -->
                            <path d="M 144 285 C 150 305, 150 305, 156 285 Z" fill="#451A03"/>

                            <!-- Interactive Clickable Hotspots -->
                            <!-- Hotspot 1: Leher / Pangkal Akar -->
                            <g class="cursor-pointer" onclick="selectRootPart('leher')">
                                <circle cx="150" cy="70" r="14" fill="#EF4444" opacity="0.3" class="hotspot-ring"/>
                                <circle cx="150" cy="70" r="10" fill="#EF4444" stroke="#FFF" stroke-width="2"/>
                                <text x="150" y="74" text-anchor="middle" font-weight="bold" fill="#FFF" font-size="10">1</text>
                            </g>

                            <!-- Hotspot 2: Batang Akar Utama -->
                            <g class="cursor-pointer" onclick="selectRootPart('batang')">
                                <circle cx="150" cy="150" r="14" fill="#3B82F6" opacity="0.3" class="hotspot-ring"/>
                                <circle cx="150" cy="150" r="10" fill="#3B82F6" stroke="#FFF" stroke-width="2"/>
                                <text x="150" y="154" text-anchor="middle" font-weight="bold" fill="#FFF" font-size="10">2</text>
                            </g>

                            <!-- Hotspot 3: Cabang Akar -->
                            <g class="cursor-pointer" onclick="selectRootPart('cabang')">
                                <circle cx="210" cy="170" r="14" fill="#10B981" opacity="0.3" class="hotspot-ring"/>
                                <circle cx="210" cy="170" r="10" fill="#10B981" stroke="#FFF" stroke-width="2"/>
                                <text x="210" y="174" text-anchor="middle" font-weight="bold" fill="#FFF" font-size="10">3</text>
                            </g>

                            <!-- Hotspot 4: Rambut Akar -->
                            <g class="cursor-pointer" onclick="selectRootPart('rambut')">
                                <circle cx="45" cy="150" r="14" fill="#F59E0B" opacity="0.3" class="hotspot-ring"/>
                                <circle cx="45" cy="150" r="10" fill="#F59E0B" stroke="#FFF" stroke-width="2"/>
                                <text x="45" y="154" text-anchor="middle" font-weight="bold" fill="#FFF" font-size="10">4</text>
                            </g>

                            <!-- Hotspot 5: Tudung Akar / Kaliptra -->
                            <g class="cursor-pointer" onclick="selectRootPart('tudung')">
                                <circle cx="150" cy="295" r="14" fill="#8B5CF6" opacity="0.3" class="hotspot-ring"/>
                                <circle cx="150" cy="295" r="10" fill="#8B5CF6" stroke="#FFF" stroke-width="2"/>
                                <text x="150" y="299" text-anchor="middle" font-weight="bold" fill="#FFF" font-size="10">5</text>
                            </g>
                        </svg>
                    </div>

                    <!-- Detail Information Box -->
                    <div class="md:col-span-6 bg-amber-50 p-5 rounded-2xl border-2 border-amber-200 min-h-[280px] flex flex-col justify-between">
                        <div id="anatomy-info-box">
                            <div class="text-center py-8 text-amber-800">
                                <i class="fas fa-hand-pointer text-4xl mb-3 text-amber-500 animate-bounce"></i>
                                <p class="font-fun text-lg font-bold">Pilih Nomor Pada Gambar!</p>
                                <p class="text-xs text-slate-600 mt-1">Klik nomor 1-5 pada diagram untuk membedah fungsi bagian akar.</p>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-amber-200 flex justify-between items-center text-xs text-amber-900 font-semibold">
                            <span>💡 Tips: Klik semua bagian untuk memahami materi secara utuh.</span>
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center mt-6 pt-4 border-t">
                    <button onclick="showScreen('materi-screen')" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 rounded-xl font-bold text-xs">
                        <i class="fas fa-arrow-left"></i> Kembali ke Materi
                    </button>
                    <button onclick="showScreen('matching-screen')" class="px-5 py-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm rounded-xl shadow">
                        Lanjut Game Pasangkan <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- ==================== 5. AKTIVITAS 2: PASANGKAN ==================== -->
        <section id="matching-screen" class="hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 shadow-xl border-4 border-sky-300">
                <div class="text-center mb-6">
                    <span class="bg-sky-100 text-sky-800 px-3 py-1 rounded-full text-xs font-bold">Aktivitas Mencocokkan</span>
                    <h2 class="text-2xl md:text-3xl font-bold text-sky-900 font-fun mt-1">Permainan Pasangkan Bagian & Fungsi 🧩</h2>
                    <p class="text-xs md:text-sm text-slate-600">Klik 1 pilihan di kolom **Bagian** lalu klik pasangannya di kolom **Fungsi**!</p>
                </div>

                <!-- Feedback Toast -->
                <div id="matching-toast" class="hidden mb-4 p-3 rounded-xl text-center font-bold text-sm transition-all duration-300"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Left Column: Bagian Akar -->
                    <div class="space-y-3">
                        <h3 class="font-fun text-sm font-bold text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                            <i class="fas fa-cubes text-sky-500"></i> Bagian Akar:
                        </h3>
                        <div id="matching-left-list" class="space-y-2">
                            <!-- Items Rendered dynamically via JS -->
                        </div>
                    </div>

                    <!-- Right Column: Fungsi Akar -->
                    <div class="space-y-3">
                        <h3 class="font-fun text-sm font-bold text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                            <i class="fas fa-bullseye text-amber-500"></i> Fungsi Utama:
                        </h3>
                        <div id="matching-right-list" class="space-y-2">
                            <!-- Items Rendered dynamically via JS -->
                        </div>
                    </div>
                </div>

                <div class="mt-6 pt-4 border-t flex justify-between items-center">
                    <button onclick="resetMatchingGame()" class="px-4 py-2 bg-amber-100 hover:bg-amber-200 text-amber-800 rounded-xl font-bold text-xs">
                        <i class="fas fa-redo"></i> Reset Permainan
                    </button>
                    <button onclick="showScreen('quiz-screen')" class="px-5 py-2 bg-rose-500 hover:bg-rose-600 text-white rounded-xl font-bold text-sm shadow">
                        Mulai Kuis Uji Pemahaman <i class="fas fa-arrow-right"></i>
